# ---------- Core ----------
# Supabase: Project Settings > Database > Connection string (Session pooler). Plain postgresql:// is fine.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000        # frontend base URL used in email links

# ---------- Storage ----------
STORAGE_BACKEND=supabase                     # local (dev) | supabase
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=                        # service_role key. Backend only, never in the browser
SUPABASE_BUCKET=case-documents               # must be a PRIVATE bucket
ENCRYPTION_KEY=                              # generate: python -m app.security

# ---------- Admin auth ----------
SUPABASE_JWT_SECRET=                         # Project Settings > API > JWT Secret (legacy HS256)
ADMIN_EMAILS=you@yourcompany.com,reviewer@yourcompany.com

# ---------- OCR service ----------
OCR_URL=http://127.0.0.1:8000
OCR_API_KEY=                                 # a dedicated service API key, not a minted user JWT
OCR_TIMEOUT_SECONDS=180
OCR_MAX_ATTEMPTS=3

# ---------- Policy ----------
MAX_UPLOAD_MB=10
UPLOAD_TOKEN_HOURS=72
CONSENT_TOKEN_HOURS=168
PRIVACY_TOKEN_MINUTES=30
RETENTION_DAYS=7
CASE_EXPIRY_DAYS=30
REMINDER_DAYS=3,7,14
MIN_OVERALL_CONFIDENCE=0.90
MIN_FIELD_CONFIDENCE=0.80
ALLOW_DOWNLOAD=false

# ---------- Email (leave SMTP_HOST empty in dev: emails are only logged) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=documents@yourcompany.com

# ---------- Optional AI fallback (used only when rules are inconclusive; sees masked data only) ----------
AI_ENABLED=false
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=

SCHEDULER_INTERVAL_SECONDS=300

# ---------- Security & Abuse Protection (Phase B4) ----------
UPLOAD_OTP_ENABLED=false
UPLOAD_OTP_EXPIRY_MINUTES=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PORTAL_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_CONSENT_PER_MINUTE=20
RATE_LIMIT_PRIVACY_PER_MINUTE=10
